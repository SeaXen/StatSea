# ─── StatSea Environment (root) ───
# Docker Compose / production deployment example.
# Setup: cp .env.example .env   (then generate a JWT secret below, or just run ./deploy.sh)

# ─── Security (REQUIRED — do not deploy with a known value) ───
# Generate a 32+ char secret with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Uncomment and paste the result, or let deploy.sh append it automatically.
# JWT_SECRET_KEY=replace-with-your-generated-secret

# Initial admin password (REQUIRED in production on a fresh database).
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# deploy.sh appends one automatically if absent. Store it somewhere safe — it is
# never logged, and the admin is forced to change it on first login.
# ADMIN_PASSWORD=replace-with-your-generated-password

# ─── Server ───
PORT=21081
# development | production (docker-compose.yml sets production)
ENVIRONMENT=production

# Access token expiry in minutes (code default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database URL (code default: sqlite:///./data/statsea_saas.db)
DATABASE_URL=sqlite:///./data/statsea_saas.db

# ─── Telemetry ───
# Production uses real packet capture / psutil metrics only.
ALLOW_SYNTHETIC_TRAFFIC=false
# Optional: pin the capture interface (default: auto-detect)
# MONITOR_INTERFACE=eth0
# Docker socket proxy for container telemetry (see docker-compose.yml)
DOCKER_HOST=tcp://127.0.0.1:2375

# ─── Frontend (optional build-time overrides) ───
# By default the frontend resolves API/WS hosts from window.location at runtime.
# VITE_API_URL=http://localhost:21081
# VITE_WS_URL=ws://localhost:21081
# Optional dev port override for API/WS resolution (default: 8001 locally)
# VITE_API_PORT=8001

# ─── CORS (optional) ───
# Comma-separated origins allowed with credentials. Empty = same-origin proxy only.
# CORS_ORIGINS=http://localhost:5173,http://localhost:21080

# ─── Notifications (optional) ───
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

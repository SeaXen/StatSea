# ─── StatSea Backend Environment (local backend development) ───
# Copy this file to backend/.env for running uvicorn directly.
# For Docker Compose / production, use the ROOT .env.example instead.

# ─── General ───
ENVIRONMENT=development
DEBUG=false

# ─── Security (REQUIRED — change these!) ───
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=CHANGE-ME-to-a-random-string-at-least-32-chars-long
ALGORITHM=HS256

# ─── Token Expiry ───
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ───
DATABASE_URL=sqlite:///./data/statsea_saas.db

# ─── CORS ───
# CORS_ORIGINS=["https://your-domain.com"]

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE=logs/statsea.log

# ─── Network Monitoring ───
NETWORK_MONITOR_INTERVAL=60
# Real capture uses these in production; synthetic traffic is disabled by default.
ALLOW_SYNTHETIC_TRAFFIC=false
# Optional: pin the capture interface (default: auto-detect)
# MONITOR_INTERFACE=eth0
# Docker socket proxy used for container telemetry (Docker Compose sets this)
# DOCKER_HOST=tcp://127.0.0.1:2375

# ─── Frontend (optional, build-time only; defaults resolve from window.location) ───
# VITE_API_URL=http://localhost:8001
# VITE_WS_URL=ws://localhost:8001

# ─── Password Policy ───
PASSWORD_MIN_LENGTH=8

# ─── Push Notifications (optional) ───
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@yourdomain.com
